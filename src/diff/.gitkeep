"""Net-Map Diff: comparación de resultados de escaneo.

Equivalente funcional a `netdiff`.
No se ejecuta automáticamente; es código fuente válido y sin errores de sintaxis.
"""

from __future__ import annotations

__all__ = ["diff_results"]


def diff_results(
    previous: dict[str, object],
    current: dict[str, object],
) -> dict[str, object]:
    """Compara dos resultados de escaneo y devuelve las diferencias.

    Args:
        previous: Resultado de escaneo anterior.
        current: Resultado de escaneo actual.

    Returns:
        Diccionario con las diferencias detectadas.
    """
    # Placeholder: la implementación real se agregará en src/diff.
    return {
        "previous_keys": sorted(previous.keys()),
        "current_keys": sorted(current.keys()),
    }
